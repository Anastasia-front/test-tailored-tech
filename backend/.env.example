# Postgres connection string (Railway provides this automatically when you
# provision a Postgres plugin; for local dev point at your own instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/data_room?schema=public"

# Server
PORT=4000
NODE_ENV=development
# Public URL of the frontend (used for CORS + OAuth redirect + share links)
FRONTEND_URL="http://localhost:5173"

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-a-long-random-string"

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="replace-me.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-me"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_S3_BUCKET="replace-me-data-room-bucket"
